# Основные контактные данные
NEXT_PUBLIC_PHONE="+7 (999) 000-00-00"
NEXT_PUBLIC_PHONE_LINK="tel:+79990000000"
NEXT_PUBLIC_EMAIL="info@example.com"
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_PHOTO_DRIVE_URL="https://disk.yandex.ru/..."

# Яндекс Метрика (ID счетчика)
NEXT_PUBLIC_YANDEX_METRICA_ID="12345678"

# Яндекс SmartCaptcha (создаются бесплатно в https://smartcaptcha.yandexcloud.net/)
# Клиентский ключ (доступен в браузере)
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=""
# Серверный секретный ключ (используется только на бэкенде)
SMARTCAPTCHA_SERVER_KEY=""

# Серверная переменная: вебхук для отправки лидов в CRM/n8n/Telegram
N8N_WEBHOOK_URL="https://example.com/n8n/webhook/your-webhook-id"
